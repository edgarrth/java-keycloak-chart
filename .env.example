# Se escriben entre comillas simples los valores que contienen espacios o caracteres de control de shell.
# Se utilizan exclusivamente credenciales de demostración local. Se reemplazan antes de publicar el servicio.
# Contraseña del administrador PostgreSQL: cadena no vacía; no se imprime en los logs.
POSTGRES_PASSWORD=Postgres2026!
# Contraseña de keycloak en PostgreSQL: cadena no vacía.
KC_DB_PASSWORD=KeycloakDB2026!
# Contraseña del lector externo PostgreSQL: cadena no vacía; dispone únicamente de SELECT.
PHONE_DB_PASSWORD=PhoneDB2026!
# Contraseña de la aplicación de pagos en PostgreSQL: cadena no vacía.
PAYMENT_DB_PASSWORD=PaymentDB2026!
# Nombre del administrador inicial de Keycloak: identificador no vacío.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
# Contraseña inicial administrativa: cadena no vacía. Solo se aplica al primer arranque.
KC_BOOTSTRAP_ADMIN_PASSWORD=Admin2026!Local
# Contraseña del DNI 12345678: mínimo 12 caracteres, mayúscula, minúscula y número.
DNI_PASSWORD=Documento2026!
# Secretos de clientes confidenciales: cadenas no vacías; se recomienda generar 32 bytes aleatorios.
PASSWORD_CLIENT_SECRET=password-client-local-2026
PHONE_CLIENT_SECRET=phone-client-local-2026
# URL pública: http://localhost:8080 para Compose o kind local; https://dominio para despliegue público con TLS.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# URL interna: http://localhost:8080 en host; http://keycloak:8080 en Compose; http://keycloak.axiz.svc:8080 en Kubernetes.
KEYCLOAK_INTERNAL_URL=http://localhost:8080
# Puerto HTTP del servicio en host: entero libre entre 1024 y 65535.
SERVER_PORT=8090
# URL JDBC de pagos: localhost:5432 en host; postgres:5432 en contenedor o Kubernetes.
PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/payments
# Usuario propietario del esquema de pagos: payments en la configuración suministrada.
PAYMENT_DB_USER=payments
# URL JDBC de identidad externa: localhost en host, postgres en contenedor o Kubernetes.
PHONE_DB_URL=jdbc:postgresql://postgres:5432/phone_identity
# Usuario de lectura de la identidad externa: phone_reader.
PHONE_DB_USER=phone_reader
# Clave de prueba del dataset telefónico: se cambia mediante datasets/generate.sh, no modifica la base ya creada.
PHONE_DEMO_PASSWORD=Telefono2026!

# URL de la API para pruebas: http://localhost:8090 en el laboratorio; una URL HTTP(S) alcanzable en otros entornos.
API_URL=http://localhost:8090
