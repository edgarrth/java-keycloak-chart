{
  "realm": "axiz",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "accessTokenLifespan": 180,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(12) and digits(1) and upperCase(1) and lowerCase(1)",
  "eventsEnabled": true,
  "eventsExpiration": 86400,
  "eventsListeners": [
    "jboss-logging"
  ],
  "roles": {
    "realm": [
      {
        "name": "merchant"
      }
    ]
  },
  "users": [],
  "authenticationFlows": [
    {
      "alias": "auth-code-dni",
      "description": "Se autentica con identificador y contraseña mediante el SPI propio del flujo.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-code-dni",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        }
      ],
      "id": "auth-code-dni"
    },
    {
      "alias": "ropc-dni",
      "description": "Se autentica con identificador y contraseña mediante el SPI propio del flujo.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "ropc-dni",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        }
      ],
      "id": "ropc-dni"
    },
    {
      "alias": "external-auth-phone",
      "description": "Se autentica con identificador y contraseña mediante el SPI propio del flujo.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "external-auth-phone",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        }
      ],
      "id": "external-auth-phone"
    }
  ],
  "browserFlow": "auth-code-dni",
  "directGrantFlow": "ropc-dni",
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "external-auth-phone",
        "providerId": "external-auth-phone-storage",
        "config": {
          "priority": [
            "0"
          ],
          "cachePolicy": [
            "NO_CACHE"
          ],
          "enabled": [
            "true"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "payments-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "secret": null,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8090/login/oauth2/code/axiz",
        "http://localhost:8090/callback-test"
      ],
      "webOrigins": [
        "http://localhost:8090"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "acr-verificado",
          "protocol": "openid-connect",
          "protocolMapper": "axiz-verified-acr",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "payments-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "payments-api"
          }
        }
      ],
      "authenticationFlowBindingOverrides": {
        "browser": "auth-code-dni"
      },
      "fullScopeAllowed": false
    },
    {
      "clientId": "payments-password",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${PASSWORD_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8090/login/oauth2/code/axiz",
        "http://localhost:8090/callback-test"
      ],
      "webOrigins": [
        "http://localhost:8090"
      ],
      "attributes": {},
      "defaultClientScopes": [
        "basic",
        "profile",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "acr-verificado",
          "protocol": "openid-connect",
          "protocolMapper": "axiz-verified-acr",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "payments-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "payments-api"
          }
        }
      ],
      "authenticationFlowBindingOverrides": {
        "direct_grant": "ropc-dni"
      },
      "fullScopeAllowed": false
    },
    {
      "clientId": "payments-phone",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${PHONE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8090/login/oauth2/code/axiz",
        "http://localhost:8090/callback-test"
      ],
      "webOrigins": [
        "http://localhost:8090"
      ],
      "attributes": {},
      "defaultClientScopes": [
        "basic",
        "profile",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "acr-verificado",
          "protocol": "openid-connect",
          "protocolMapper": "axiz-verified-acr",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "payments-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "payments-api"
          }
        }
      ],
      "authenticationFlowBindingOverrides": {
        "direct_grant": "external-auth-phone"
      },
      "fullScopeAllowed": false
    }
  ],
  "scopeMappings": [
    {
      "client": "payments-web",
      "roles": [
        "merchant"
      ]
    },
    {
      "client": "payments-password",
      "roles": [
        "merchant"
      ]
    },
    {
      "client": "payments-phone",
      "roles": [
        "merchant"
      ]
    }
  ],
  "loginTheme": "axiz",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "es"
  ],
  "defaultLocale": "es"
}
